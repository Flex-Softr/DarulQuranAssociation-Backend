# =============================================================================
# DarulQuran Foundation — Backend Environment Variables
# =============================================================================

# Server Configuration
PORT=5002
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>

# JWT Secrets (at least 32 characters each)
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production-min-32-chars

# Token Expiration
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# CORS Configuration (comma-separated origins or '*' for dev)
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# File Upload
UPLOAD_DIR=./uploads

# Password Hashing
SALT_ROUNDS=12

# Payment Gateway (SSLCommerz)
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_LIVE=false

# Optional URLs used by controllers for redirects
BASE_URL=http://localhost:5002
FRONTEND_URL=http://localhost:3000

# Database Seeding (Optional — set SEED_ADMIN=true on first run)
SEED_ADMIN=false
SEED_ADMIN_NAME=Admin User
SEED_ADMIN_EMAIL=admin@darulquran.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_SAMPLE_USERS=false
SEED_SAMPLE_EDITOR_PHONE=
SEED_SAMPLE_ADMIN_PHONE=
SEED_SAMPLE_DONOR_PHONE=